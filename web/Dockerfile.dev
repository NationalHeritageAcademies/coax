# LOCAL DEV ONLY — build of the Coax marketing site for `docker compose up`.
# Named Dockerfile.dev (not Dockerfile) because Railway auto-detects a file
# named "Dockerfile" and switches the production build away from Nixpacks,
# which breaks the shell-less startCommand ($PORT never expands). Production
# stays on nixpacks.toml + railway.toml.
#
# Mirrors the Railway deployment: PHP 8.2, composer install, PHP's built-in
# server pointed at public/.
#
#   docker compose up --build        # from web/, then http://localhost:8080
#
# APP_ENV is intentionally unset for local runs (base config.json, debug on).
# Set APP_ENV=pd to exercise the production config overlay.

FROM composer:2 AS deps
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-progress --optimize-autoloader

FROM php:8.2-cli
WORKDIR /app
COPY . .
COPY --from=deps /app/vendor ./vendor
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "php -S 0.0.0.0:${PORT} -t public public/index.php"]
