{
  "name": "coax",
  "productName": "Coax",
  "version": "1.3.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NationalHeritageAcademies/coax.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "coax": "packages/coax-cli/coax.cjs"
  },
  "scripts": {
    "predev": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "prebuild": "electron-builder install-app-deps",
    "build": "electron-vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "prepreview": "electron-builder install-app-deps",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "package:dist": "electron-builder --mac --win",
    "package:all": "electron-builder --mac --win --linux",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package:win:test": "npm run build && SKIP_WIN_SIGN=1 electron-builder --win --publish never",
    "postpackage:win:test": "npm run rebuild:native",
    "postpackage": "npm run rebuild:native",
    "postpackage:dist": "npm run rebuild:native",
    "postpackage:all": "npm run rebuild:native",
    "release": "npm run build && electron-builder --mac --win --linux --publish always",
    "postinstall": "electron-builder install-app-deps",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build && electron-rebuild -f -w better-sqlite3",
    "test:e2e": "playwright test",
    "posttest:e2e": "npm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "icons": "python3 scripts/generate-icons.py",
    "icons:set": "node scripts/generate-icon-set.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.6",
    "@angular/compiler": "^21.0.6",
    "@angular/core": "^21.0.6",
    "@angular/forms": "^21.0.6",
    "@angular/platform-browser": "^21.0.6",
    "@sentry/electron": "^7.13.0",
    "better-sqlite3": "^11.3.0",
    "commander": "^14.0.3",
    "electron-updater": "^6.8.3",
    "jsonpath-plus": "^10.0.0",
    "monaco-editor": "^0.52.0",
    "rxjs": "^7.8.1",
    "undici": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular/animations": "^21.0.6",
    "@angular/build": "^21.0.4",
    "@angular/compiler-cli": "^21.0.6",
    "@eslint/js": "^9.39.5",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/angular": "^17.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^4.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.12.0",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "node-gyp": "^11.5.0",
    "prettier": "^3.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^4.1.10"
  }
}
