# Template for local environment overrides. Copy to .env.local and fill in.
# .env.local is gitignored so secrets stay on your machine.
#
# Everything here is OPTIONAL — a plain `npm run dev` / `npm run build` works
# with no .env.local at all.

# Sentry crash reporting. Leave blank to disable telemetry entirely —
# the SDK never initializes without a DSN, so no network calls are made.
# Even with a DSN baked in, nothing is sent unless the user opts in to
# crash reporting in-app. Get a DSN at https://sentry.io after creating
# an Electron project.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Azure Trusted Signing — used by scripts/sign-windows.cjs to Authenticode-sign
# the Windows .exe and uninstaller during `npm run package`. Without these the
# Windows installer ships unsigned and Defender quarantines it mid-install.
# Only needed when producing official signed Windows builds.
#
# Prereq: `brew install jsign` (the cross-platform signer that talks to the
# Trusted Signing REST API — no Wine, no Windows VM needed).
#
# Service principal: create an App Registration in Entra ID, generate a client
# secret, and grant it the "Trusted Signing Certificate Profile Signer" role on
# the certificate profile resource in Azure.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Region endpoint of the Trusted Signing account (e.g. https://eus.codesigning.azure.net
# for East US, https://wus.codesigning.azure.net for West US).
TRUSTED_SIGNING_ENDPOINT=
# Artifact Signing account name (e.g. nha-signing). NHA values TBD — see docs/windows-signing-setup.md.
TRUSTED_SIGNING_ACCOUNT=
# Certificate profile name under the account (e.g. coax-cert-profile).
TRUSTED_SIGNING_PROFILE=

# macOS notarization (scripts/notarize.cjs) uses a keychain profile rather
# than env vars. Official builds require one-time setup:
#   xcrun notarytool store-credentials coax-notarize \
#     --apple-id <id> --team-id 2X78QR5M8K --password <app-specific-password>
# (2X78QR5M8K is the NHA Apple Developer team.)

# GitHub token with `repo` scope — used by `npm run release` to upload
# artifacts to a GitHub Release via electron-builder.
GH_TOKEN=
